# ===================================================================
# NEXORA Spring Boot Backend Environment Configuration Template
# ===================================================================
# Copy this file to .env or set environment variables in your terminal/IDE.
# Never commit production passwords or JWT keys into source control.

# Server Port
SERVER_PORT=8080

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/nexora_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# JWT Secret (Must be a 256-bit minimum Hex or Base64 encoded key)
# Generate with: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo Data Bootstrap (true = seed sample providers & categories if empty)
SEED_ENABLED=true
