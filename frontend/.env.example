# NEXORA Environment Configuration

# Future Spring Boot Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Optional Third-Party Maps API Key Placeholder (e.g. Mapbox, Google Maps, Geoapify)
# NEXORA defaults to free OpenStreetMap tiles via Leaflet with zero API key required.
VITE_MAPS_API_KEY=YOUR_OPTIONAL_MAPS_API_KEY_HERE

# Application Mode: 'mock' (current frontend phase) or 'live' (future Spring Boot)
VITE_DATA_MODE=mock
